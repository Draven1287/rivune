{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rivune",
  "version": "0.0.1",
  "identifier": "com.rivune.desktop.development",
  "build": {
    "frontendDist": "../../../../prototypes/ai-native-workspace/dist-desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    },
    "windows": [
      {
        "title": "Rivune",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "targets": [
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "shortDescription": "A local multi-AI workspace"
  }
}
