{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rivune",
  "version": "0.0.1",
  "identifier": "com.rivune.desktop.development",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    },
    "windows": [{
      "title": "Rivune",
      "width": 1120,
      "height": 760,
      "minWidth": 760,
      "minHeight": 560,
      "resizable": true
    }]
  },
  "bundle": {
    "active": true,
    "icon": [],
    "targets": "all",
    "shortDescription": "A local multi-AI workspace"
  }
}
