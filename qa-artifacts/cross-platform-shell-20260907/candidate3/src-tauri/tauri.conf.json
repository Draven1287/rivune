{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rivune Shell Spike",
  "version": "0.0.1",
  "identifier": "com.rivune.shell.spike",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    },
    "windows": [{
      "title": "Rivune Shell Spike",
      "width": 1120,
      "height": 760,
      "minWidth": 760,
      "minHeight": 560,
      "resizable": true
    }]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Rivune cross-platform architecture prototype"
  }
}
