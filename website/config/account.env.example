# Public build configuration only. Copy these names into the website build environment.
# Leave disabled until the owner configures and tests the Auth project and redirect URLs.
NEXT_PUBLIC_RIVUNE_AUTH_ENABLED=false
NEXT_PUBLIC_RIVUNE_SUPABASE_URL=
NEXT_PUBLIC_RIVUNE_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_RIVUNE_AUTH_EMAIL_ENABLED=false
NEXT_PUBLIC_RIVUNE_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_RIVUNE_AUTH_APPLE_ENABLED=false

# Never put a service-role key, sb_secret key, OAuth client secret or Apple signing key here.
